# Copy to .env and fill in. .env is gitignored and must never be committed.
# Both tiers below are OPTIONAL -- the three free crawlers work without them.
# Leave a line blank or delete it to skip that tier.

# https://console.apify.com/settings/integrations  ("Personal API token")
APIFY_TOKEN=

# https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=
