# Copy to .env and fill in. .env is gitignored and must never be committed.
# Every key below is OPTIONAL -- the three free crawlers and Claude work without them.
# Leave a line blank or delete it to skip it.

# https://console.apify.com/settings/integrations  ("Personal API token")
APIFY_TOKEN=

# https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# https://console.typesafe.ai/settings/keys
# Lets you pick TypeSafe as a campaign's judge at /new: it decides Fitment and
# Ranking, Claude still writes the comments. Without it, Claude judges.
TYPESAFE_API_KEY=
